# CAPNEXA Docker Environment Configuration
# COPY THIS FILE TO .env AND REPLACE ALL REPLACE_WITH_* VALUES
# NEVER COMMIT .env TO VERSION CONTROL

# =============================================================================
# DATABASE (SQL Server)
# =============================================================================
# SA password for SQL Server - MUST be at least 8 chars with upper, lower, digit, symbol
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SA_PASSWORD

# Connection string for the API - uses the same password as above
# Format: Server=db,1433;Database=CapnexaDb;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True
DB_CONNECTION_STRING=Server=db,1433;Database=CapnexaDb;User Id=sa;Password=REPLACE_WITH_STRONG_SA_PASSWORD;TrustServerCertificate=True

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Random string of at least 64 characters (used to sign access tokens)
# Generate with PowerShell: [BitConverter]::ToString((1..32 | ForEach-Object { [byte](Get-Random -Max 256) })).Replace('-', '')
# Or Linux/macOS: openssl rand -hex 32
JWT_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING

# Token issuer - must match the API URL
JWT_ISSUER=https://api.capnexa.local

# Token audience - client identifier
JWT_AUDIENCE=capnexa-client

# Access token lifetime in minutes (default: 15)
JWT_ACCESS_TOKEN_EXPIRES_IN_MINUTES=15

# Refresh token lifetime in days (default: 7)
JWT_REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# =============================================================================
# APPLICATION URLS (used for CORS, OAuth redirects, email links)
# =============================================================================
# API base URL (Caddy will proxy https://api.capnexa.local -> api:8080)
APP_API_BASE_URL=https://api.capnexa.local

# Frontend base URL (Caddy will proxy https://capnexa.local -> web:80)
APP_FRONTEND_BASE_URL=https://capnexa.local

# Frontend OAuth callback path (relative to frontend base URL)
FRONTEND_OAUTH_CALLBACK_PATH=/oauth/callback

# =============================================================================
# SEED ADMIN USER (created automatically on first API startup)
# =============================================================================
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
SEED_ADMIN_USER_NAME=admin
SEED_ADMIN_EMAIL=admin@capnexa.local
# Strong password for the seeded admin account
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# =============================================================================
# EMAIL SETTINGS (SMTP) - REQUIRED for email confirmation to work
# =============================================================================
# Sender email address (use a valid-looking address even for dev)
EMAIL_SETTINGS_EMAIL=capnexa-noreply@example.com

# SMTP password / app password - leave empty for dev (breaks email sending)
# For production, use real SMTP credentials (SendGrid, Mailgun, etc.)
EMAIL_SETTINGS_PASSWORD=REPLACE_WITH_SMTP_PASSWORD_OR_LEAVE_EMPTY_FOR_DEV

# SMTP Host (optional - only needed if not using default provider)
# EMAIL_SETTINGS_HOST=smtp.example.com
# EMAIL_SETTINGS_PORT=587
# EMAIL_SETTINGS_ENABLE_SSL=true

# =============================================================================
# GOOGLE OAUTH (optional - leave empty if not using)
# =============================================================================
# Get from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
# Callback path is fixed in the API
# GOOGLE_CALLBACK_PATH=/api/Identity/Auth/google/callback

# =============================================================================
# GITHUB OAUTH (optional - leave empty if not using)
# =============================================================================
# Get from GitHub Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
# Callback path is fixed in the API
# GITHUB_CALLBACK_PATH=/api/Identity/Auth/github/callback

# =============================================================================
# CADDY PORTS (change only if 80/443 are in use)
# =============================================================================
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# =============================================================================
# COMPOSE PROJECT NAME (optional - distinguishes multiple stacks)
# =============================================================================
COMPOSE_PROJECT_NAME=capnexa

# =============================================================================
# ASPNETCORE ENVIRONMENT (Development enables OpenAPI/Scalar)
# =============================================================================
# Set to Production for production-like deployment
# ASPNETCORE_ENVIRONMENT=Production