COMPOSE_PROJECT_NAME=capnexa

# SQL Server 2022 (local development only). Must satisfy SQL Server complexity rules.
MSSQL_SA_PASSWORD=REPLACE_WITH_SQL_PASSWORD
DB_CONNECTION_STRING=Server=db;Database=CapnexaDb;User Id=sa;Password=REPLACE_WITH_SQL_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true

# API configuration. Keys match appsettings.json exactly (double underscore for nested keys).
JWT_ISSUER=CAPNEXAAPI
JWT_AUDIENCE=CAPNEXA-Client
JWT_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_64_CHARACTERS
JWT_ACCESS_TOKEN_EXPIRES_IN_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_IN_DAYS=7
APP_API_BASE_URL=https://api.capnexa.local
APP_FRONTEND_BASE_URL=https://capnexa.local
FRONTEND_OAUTH_CALLBACK_PATH=/oauth/callback

# Leave empty unless you have real OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Leave empty by default. Registration still works, but email confirmation cannot be sent.
EMAIL_SETTINGS_EMAIL=
EMAIL_SETTINGS_PASSWORD=

# Seeded Admin account used for local development.
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin
SEED_ADMIN_USER_NAME=admin
SEED_ADMIN_EMAIL=admin@capnexa.local
SEED_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Vite build-time configuration.
VITE_API_BASE_URL=https://api.capnexa.local
VITE_AUTH_MODE=preview

# Host ports for Caddy.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
